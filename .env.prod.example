# EC2 배포용 .env 템플릿. 서버에서 `cp .env.prod.example .env` 후 값을 채운다.
# compose.prod.yaml 이 DB_URL/MONGODB_URI/APP_STORAGE_ROOT 는 컨테이너 이름 기준으로 덮어쓴다.

# --- 접속 도메인 -------------------------------------------------------------
# TLS 붙이기 전 (HTTP)
FRONTEND_BASE_URL=http://ktb-ai-hackathon-team14.com
SESSION_COOKIE_SECURE=false
NGINX_CONF=nginx.conf

# TLS 발급 후에는 위 3줄을 아래로 교체
# FRONTEND_BASE_URL=https://ktb-ai-hackathon-team14.com
# SESSION_COOKIE_SECURE=true
# NGINX_CONF=nginx.tls.conf

# --- 카카오 ------------------------------------------------------------------
# REST API 키. 콘솔 Redirect URI 에 {FRONTEND_BASE_URL}/api/v1/auth/kakao/callback 등록 필수.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- AI 연동 -----------------------------------------------------------------
# AI 서버는 저장소의 ai/ 디렉토리에서 빌드되어 ai 컨테이너로 같이 뜬다.
#
# AI_MODE 는 stub / http 두 값만 유효하다. 다른 값(live, prod 등)을 넣으면
# AiAnalysisClient 빈이 생성되지 않아 백엔드가 기동에 실패한다.
#   stub : 더미 응답. AI 서버 없이도 서비스가 전부 동작한다 (기본값).
#   http : 실제 AI 서버(ai 컨테이너) 호출. 배포에서는 이 값으로 둔다.
AI_MODE=http

# 컨테이너로 같이 띄우는 지금 구성에서는 compose 기본값(http://ai:8000)이 맞으므로
# 설정하지 않는다. AI 서버를 다른 곳에 둘 때만 오리진을 적는다 (경로는 넣지 말 것).
#   같은 VPC 안 별도 인스턴스:  http://10.0.1.23:8000
#   별도 도메인이면:            https://ai.example.com
#   localhost 는 백엔드 컨테이너 자신을 가리키므로 동작하지 않는다.
# AI_BASE_URL=http://ai:8000

# 백엔드와 AI 서버가 공유하는 내부 서비스 토큰. 임의의 랜덤 문자열이면 된다.
# compose 가 이 값 하나를 백엔드(AI_SERVICE_TOKEN)와 ai(AI_INTERNAL_SERVICE_TOKEN)
# 양쪽에 주입하므로 여기서만 관리한다.
AI_SERVICE_TOKEN=replace-me

# Gemini API 키. ai 컨테이너의 LLM 호출에 필수 (없으면 기동 자체를 막는다).
GOOGLE_API_KEY=

# AI 호출 타임아웃 (기본 90s)
# AI_TIMEOUT=90s

# --- DB (호스트에서 직접 붙을 때만 사용. 컨테이너는 compose가 덮어씀) ---------
DB_URL=jdbc:postgresql://localhost:5432/relationship_temperature
DB_USERNAME=relationship_temperature
DB_PASSWORD=relationship_temperature
MONGODB_URI=mongodb://relationship_temperature:relationship_temperature@localhost:27017/relationship_temperature?authSource=admin&uuidRepresentation=standard

# 업로드 원문 저장 경로. 컨테이너 실행 시 compose 가 /app/data/uploads 로 덮어쓰므로
# 아래 값은 호스트에서 직접 bootRun 할 때만 쓰인다. 배포에서는 손대지 않아도 된다.
APP_STORAGE_ROOT=./data/uploads
