# 로컬 실행용 환경변수 템플릿. `cp .env.example .env` 후 docker compose up 하면 된다.
# DB_URL/MONGODB_URI/APP_STORAGE_ROOT 는 컨테이너 실행 시 compose 가 서비스 이름 기준으로 덮어쓴다.

DB_URL=jdbc:postgresql://localhost:5432/relationship_temperature
DB_USERNAME=relationship_temperature
DB_PASSWORD=relationship_temperature
MONGODB_URI=mongodb://relationship_temperature:relationship_temperature@localhost:27017/relationship_temperature?authSource=admin

# 카카오 REST API 키 / Client Secret
KAKAO_CLIENT_ID=865f6382a4ab1950bea0900387119414
KAKAO_CLIENT_SECRET=E0ceoWX4znJpUAI11BPYflngQgoKDy79
FRONTEND_BASE_URL=http://localhost:5173

# --- AI 연동 -----------------------------------------------------------------
# stub : 더미 분석 결과. API 키 없이도 전체 흐름이 동작한다 (기본값).
# http : ai 컨테이너(./ai, FastAPI)를 실제 호출한다. GOOGLE_API_KEY 가 필요하다.
AI_MODE=stub
AI_BASE_URL=http://localhost:8000
# 백엔드 ↔ ai 컨테이너가 공유하는 내부 토큰. compose 가 양쪽에 같은 값을 넣는다.
AI_SERVICE_TOKEN=local-ai-token
# Gemini API 키. AI_MODE=http 일 때 필수.
GOOGLE_API_KEY=
# (선택) Claude 를 쓰는 경로용. 보통 비워둔다.
ANTHROPIC_API_KEY=

APP_STORAGE_ROOT=./data/uploads
